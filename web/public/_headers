# Cloudflare Pages headers for the static client-side demo.
# Cross-origin isolation is required for onnxruntime-web (WASM threads / WebGPU /
# SharedArrayBuffer). Mirrors the COOP/COEP the backend (api/main.py) and Caddy send.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# Cache the immutable hashed build assets (incl. the ~26 MB ORT wasm) aggressively.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Keep the Docker build context small + never ship private/local artifacts.
.venv/
.git/
.claude/
web/node_modules/
web/dist/
submodules/
results/
# data/ may hold large/derived artifacts (ignored) EXCEPT the small committed
# CC-BY / CC-BY-SA / CC0 sample datasets that must ship for genuine offline runtime
# (e.g. the genomics PGS-Catalog PRS weights — see DATA_LICENSES.md).
data/*
!data/genomics
!data/finance
!data/satellite
logs/
references/*.pdf
*.docx
MONETIZATION*.md
**/__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
# Round 65: the image builds the MPC wasm itself (docker/Dockerfile.web, stage `wasm`), so neither its
# Rust build outputs nor a locally generated copy of the package may reach the context; and nothing
# under prototypes/ ships.
wasm/qsh-mpc/target/
wasm/qsh-mpc/.cargo-home/
web/src/wasm/
web/public/licenses/qsh-mpc.txt
prototypes/

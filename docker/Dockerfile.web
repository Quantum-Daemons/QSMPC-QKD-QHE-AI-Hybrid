# Build the MPC wasm, then the SPA, then serve the static bundle with Caddy (auto-HTTPS + COOP/COEP).

# The garbled-circuit tier (wasm/qsh-mpc, on Polytune), Round 65: tested, built, and its third-party
# notices collected. CARGO_JOBS limits the compile's parallelism because the demo host is shared; and
# the layers above the COPY of wasm/qsh-mpc are cached, so a deploy that does not change the crate
# does not recompile it. The base image is pinned by digest as well as by tag.
FROM rust:1.99.1-bookworm@sha256:48b7f435b8fc6378ce43b44f15e3a47fd8919b2825f835c39bd4bd3da50af5b8 AS wasm
ARG CARGO_JOBS=2
ENV CARGO_BUILD_JOBS=${CARGO_JOBS}
RUN rustup target add wasm32-unknown-unknown \
 && cargo install --locked wasm-pack@0.15.0 \
 && cargo install --locked wasm-bindgen-cli@0.2.129
WORKDIR /src
COPY wasm/qsh-mpc/ ./
RUN cargo fetch --locked
# The Rust tests run in every image build, the public demo's included: the module that ships is one
# whose argmax was just checked against the plaintext argmax.
RUN cargo test --release --locked
RUN RUSTFLAGS='--cfg getrandom_backend="wasm_js"' wasm-pack build --target web --release \
      --out-dir /out/qsh_mpc --out-name qsh_mpc -- --locked \
 && rm -f /out/qsh_mpc/.gitignore /out/qsh_mpc/package.json /out/qsh_mpc/README.md \
 && python3 notices.py /out/qsh-mpc-notices.txt

# The threshold-aggregation tier (wasm/qsh-fedthresh, on Lattigo v6.2.0), Round 86: the four hospitals' collective
# key generation, encryption, and one collective decryption per round, compiled from Go to WebAssembly. The stage runs
# the module's Go tests first, so the binary that ships is one whose BGV aggregate was just checked to be exact and
# whose CKKS errors were just bounded. The base image is pinned by digest as well as by tag.
FROM golang:1.27.4-bookworm@sha256:4fa7c968ba93f1635670522dbb01a2c78150443e1385746924566079f36570ea AS fedthresh
WORKDIR /src
COPY wasm/qsh-fedthresh/go.mod wasm/qsh-fedthresh/go.sum ./
RUN go mod download && go mod verify
COPY wasm/qsh-fedthresh/ ./
RUN go vet ./... && go test ./agg/
RUN mkdir -p /out/qsh_fedthresh \
 && GOOS=js GOARCH=wasm go build -trimpath -ldflags="-s -w" -o /out/qsh_fedthresh/qsh_fedthresh.wasm ./cmd/wasm \
 && cp "$(go env GOROOT)/lib/wasm/wasm_exec.js" /out/qsh_fedthresh/wasm_exec.js \
 && python3 notices.py /out/qsh-fedthresh-notices.txt

# What scripts/build_wasm.sh exports for local builds and CI: the same files the image uses.
FROM scratch AS wasm-out
COPY --from=wasm /out/ /
COPY --from=fedthresh /out/ /

FROM node:22.23.4-alpine@sha256:fe4f6d74e20370acb04ad889077d14d0f64a9c8ea6a42bc60cddf1e844699914 AS build
WORKDIR /web
# CLIENT_ONLY=1 bakes the client-side-compute demo into the bundle (no /api compute);
# left empty for the full backend-driven deployment.
ARG CLIENT_ONLY=
ENV VITE_CLIENT_ONLY=${CLIENT_ONLY}
COPY web/package.json web/package-lock.json* ./
# onnxruntime-node, a dependency of @huggingface/transformers that the bundle never imports, would
# download CUDA binaries from api.nuget.org here; skipped, as in CI (Round 76).
ENV ONNXRUNTIME_NODE_INSTALL=skip
RUN npm ci
COPY web/ ./
COPY --from=wasm /out/qsh_mpc ./src/wasm/qsh_mpc
COPY --from=wasm /out/qsh-mpc-notices.txt ./public/licenses/qsh-mpc.txt
COPY --from=fedthresh /out/qsh_fedthresh ./public/wasm/qsh_fedthresh
COPY --from=fedthresh /out/qsh-fedthresh-notices.txt ./public/licenses/qsh-fedthresh.txt
RUN npm run build

# The Python walkthrough (Round 86): a marimo static export, with Pyodide and its packages fetched here against the
# checksums recorded in walkthroughs/pyodide-sources.json, so that the page loads nothing from another origin.
FROM python:3.12.16-slim-bookworm@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df AS walkthrough
WORKDIR /w
COPY walkthroughs/ ./walkthroughs/
COPY scripts/build_walkthrough.py ./scripts/
RUN pip install --no-cache-dir --require-hashes -r walkthroughs/requirements.lock
RUN python scripts/build_walkthrough.py /out

FROM caddy:2.11.8-alpine@sha256:f6228111e5fafa1a5238258d0858e103f10599b8d1659a146e7726681a002bb9
# Two Caddyfiles: the full deployment proxies /api, the client-only demo has no backend to proxy to
# and must not advertise one. CLIENT_ONLY selects which survives into the image.
ARG CLIENT_ONLY=
COPY docker/env/Caddyfile /etc/caddy/Caddyfile
COPY docker/env/Caddyfile.client-only /tmp/Caddyfile.client-only
RUN if [ "$CLIENT_ONLY" = "1" ]; then mv /tmp/Caddyfile.client-only /etc/caddy/Caddyfile; \
    else rm -f /tmp/Caddyfile.client-only; fi
COPY --from=build /web/dist /srv
COPY --from=walkthrough /out /srv/walkthrough

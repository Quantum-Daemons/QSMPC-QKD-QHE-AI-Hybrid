# Slim PUBLIC-DEMO backend image (crypto + API only — NO FHE, NO torch/AI). Measured 1.77 GB vs
# 5.07 GB for the full image = 3.30 GB smaller (round11 tags; re-measure after a rebuild). The
# full image (torch CPU + tenseal + openfhe dropped), which fits the ConoHa demo VPS comfortably.
# The public demo computes everything client-side (onnxruntime-web WASM/WebGPU, @noble, in-browser AI),
# so this image only needs to serve /api/health and the lightweight /api/demo/* crypto endpoints (for
# NOTE: no longer deployed with the public demo. It was the `?demo=full`-on-VPS fallback until
# Round 17 found that fallback could not work -- this image omits FHE/torch on purpose, so a run
# routed to it dies at `No module named 'tenseal'`. Kept for local full-stack use only.
# The full backend (federated + inference) lives in Dockerfile.api.
# Safe because stages.py imports the heavy deps lazily (inside functions), so api.main loads with core only.
FROM python:3.12-slim-trixie

ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 LD_LIBRARY_PATH=/usr/local/lib
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake ninja-build git libssl-dev ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# liboqs C lib at build time so /api/demo/pqc + /api/demo/mcp work offline (cheap; the demo's whole point).
RUN git clone --depth 1 https://github.com/open-quantum-safe/liboqs /tmp/liboqs \
 && cmake -S /tmp/liboqs -B /tmp/liboqs/build -GNinja \
      -DBUILD_SHARED_LIBS=ON -DCMAKE_INSTALL_PREFIX=/usr/local -DOQS_BUILD_ONLY_LIB=ON \
 && cmake --build /tmp/liboqs/build --parallel \
 && cmake --install /tmp/liboqs/build && ldconfig && rm -rf /tmp/liboqs

# core (numpy/scipy/qiskit/pennylane/liboqs-python/cryptography/scikit-learn) + api (fastapi/uvicorn) ONLY.
# Deliberately NO requirements-fhe.txt (tenseal/openfhe/mpyc) and NO requirements-ai.txt (torch/flwr).
COPY requirements-core.txt requirements-api.txt pyproject.toml ./
RUN pip install --upgrade pip wheel setuptools \
 && pip install -r requirements-core.txt -r requirements-api.txt

COPY src ./src
COPY api ./api
RUN pip install -e .

# Verify oqs finds the prebuilt shared library + that api.main imports with core-only deps (no torch/FHE).
RUN python -c "import oqs; print('liboqs', oqs.oqs_version())"
RUN python -c "import api.main; print('api.main imports OK (core-only slim demo image)')"

EXPOSE 8000
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]

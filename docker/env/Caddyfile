# Caddy: serve the SPA static bundle, reverse-proxy /api (+ WebSocket), set the
# cross-origin isolation headers WASM/WebGPU need, and obtain HTTPS automatically.
#
# The site address is env-configurable: SITE_ADDRESS defaults to ":80" (local HTTP). Set
# SITE_ADDRESS=your-domain.example (passed to the web container) and Caddy auto-provisions a
# Let's Encrypt cert + serves HTTPS — no file edit needed. (See docs/deployment.md.)
{$SITE_ADDRESS::80} {
	encode gzip zstd

	# Cross-origin isolation -> SharedArrayBuffer / WebGPU / threaded WASM
	header {
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Embedder-Policy "require-corp"
		Cross-Origin-Resource-Policy "cross-origin"
	}
	@wasm path *.wasm
	header @wasm Content-Type application/wasm

	# Caching (Round 86, 2026-11-15). Vite names every file under /assets/ by its content hash, so a name never
	# changes meaning and is kept for a year. Everything else, the app shell above all, is revalidated on each load
	# (ETag, a 304 when unchanged). With no header Chrome kept a shell by its heuristic, a tenth of the time since
	# Last-Modified, and after a deploy loaded a bundle the new image no longer serves. Both Caddyfiles carry it.
	# Only a file that exists: a 404 for a hash the image does not have must not be kept for a year, or a rollback
	# to the image that has it would stay broken in that browser.
	@hashed {
		path /assets/*
		file {
			root /srv
		}
	}
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@unhashed {
		not {
			path /assets/*
			file {
				root /srv
			}
		}
	}
	header @unhashed Cache-Control "no-cache"

	# API + WebSocket -> backend container (handled exclusively, before the SPA)
	handle /api/* {
		reverse_proxy api:8000
	}
	handle /metrics {
		reverse_proxy api:8000
	}

	# Everything else -> SPA static files with history-API fallback
	# Only an APP ROUTE falls back to the SPA shell. A path with a file extension is a file: served
	# when it exists and a 404 when it does not. `try_files {path} /index.html` answered every missing
	# path with index.html and a 200, so a missing chunk (a page loaded before a deploy asking for a
	# hash that no longer exists), data file or licence came back as HTML. The browser then reported
	# a MIME or JSON parse error instead of a 404, which hides what is missing. Round 74. Both
	# Caddyfiles carry it.
	handle {
		root * /srv
		@route {
			not path_regexp \.[A-Za-z0-9]+$
			not file
		}
		rewrite @route /index.html
		file_server
	}
}

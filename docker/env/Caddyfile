# Caddy: serve the SPA static bundle, reverse-proxy /api (+ WebSocket), set the
# cross-origin isolation headers WASM/WebGPU need, and obtain HTTPS automatically.
#
# The site address is env-configurable: SITE_ADDRESS defaults to ":80" (local HTTP). Set
# SITE_ADDRESS=your-domain.example (passed to the web container) and Caddy auto-provisions a
# Let's Encrypt cert + serves HTTPS — no file edit needed. (See the deploy runbook.)
{$SITE_ADDRESS::80} {
	encode gzip zstd

	# Cross-origin isolation -> SharedArrayBuffer / WebGPU / threaded WASM
	header {
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Embedder-Policy "require-corp"
		Cross-Origin-Resource-Policy "cross-origin"
	}
	@wasm path *.wasm
	header @wasm Content-Type application/wasm

	# API + WebSocket -> backend container (handled exclusively, before the SPA)
	handle /api/* {
		reverse_proxy api:8000
	}
	handle /metrics {
		reverse_proxy api:8000
	}

	# Everything else -> SPA static files with history-API fallback
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

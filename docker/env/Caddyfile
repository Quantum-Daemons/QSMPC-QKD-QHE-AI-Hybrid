# Caddy: serve the SPA static bundle, reverse-proxy /api (+ WebSocket), set the
# cross-origin isolation headers WASM/WebGPU need, and obtain HTTPS automatically.
#
# The site address is env-configurable: SITE_ADDRESS defaults to ":80" (local HTTP). Set
# SITE_ADDRESS=your-domain.example (passed to the web container) and Caddy auto-provisions a
# Let's Encrypt cert + serves HTTPS — no file edit needed. (See docs/deployment.md.)
{$SITE_ADDRESS::80} {
	encode gzip zstd

	# Cross-origin isolation -> SharedArrayBuffer / WebGPU / threaded WASM
	header {
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Embedder-Policy "require-corp"
		Cross-Origin-Resource-Policy "cross-origin"
	}
	# Security headers (Round 86, 2026-11-20, the owner's choice of an enforced Content-Security-Policy). HSTS for a
	# year, this host only (no includeSubDomains: other hosts share the registered domain); no MIME sniffing; the
	# browsers' default referrer policy, stated. The app's policy allows scripts and workers from this site only, wasm
	# compilation, and fetches to this site and to Hugging Face, which serves the pinned model files and redirects to
	# its CDN (huggingface.co and *.hf.co, the only other hosts a full walk of every page and run contacted on
	# 2026-11-20). style-src keeps 'unsafe-inline' for the style attributes in index.html and the <style> elements
	# mermaid writes into its diagrams. The Python walkthrough is a static marimo export with four inline scripts and a
	# chart library that compiles expressions, so it has its own, looser policy, under /walkthrough/ only.
	header {
		>Strict-Transport-Security "max-age=31536000"
		>X-Content-Type-Options "nosniff"
		>Referrer-Policy "strict-origin-when-cross-origin"
	}
	@app_csp not path /walkthrough /walkthrough/*
	header @app_csp >Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://huggingface.co https://*.huggingface.co https://*.hf.co; worker-src 'self' blob:; media-src 'self' blob:; frame-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
	# A stricter candidate, reported and not enforced (the owner's choice of 2026-11-20, measure first): the app's policy
	# without 'unsafe-inline' for styles. Each page's buffered ReportingObserver, and web/scripts/check_csp.mjs, list what it
	# would block, so the inline-style needs can be removed one at a time before it is enforced.
	header @app_csp >Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://huggingface.co https://*.huggingface.co https://*.hf.co; worker-src 'self' blob:; media-src 'self' blob:; frame-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
	@walkthrough_csp path /walkthrough /walkthrough/*
	header @walkthrough_csp >Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; frame-src 'self' blob: data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
	@wasm path *.wasm
	header @wasm Content-Type application/wasm

	# Caching (Round 86, 2026-11-15). Vite names every file under /assets/ by its content hash, so a name never
	# changes meaning and is kept for a year. Everything else, the app shell above all, is revalidated on each load
	# (ETag, a 304 when unchanged). With no header Chrome kept a shell by its heuristic, a tenth of the time since
	# Last-Modified, and after a deploy loaded a bundle the new image no longer serves. Both Caddyfiles carry it.
	# Only a file that exists: a 404 for a hash the image does not have must not be kept for a year, or a rollback
	# to the image that has it would stay broken in that browser.
	@hashed {
		path /assets/*
		file {
			root /srv
		}
	}
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@unhashed {
		not {
			path /assets/*
			file {
				root /srv
			}
		}
	}
	header @unhashed Cache-Control "no-cache"

	# API + WebSocket -> backend container (handled exclusively, before the SPA)
	handle /api/* {
		reverse_proxy api:8000
	}
	handle /metrics {
		reverse_proxy api:8000
	}

	# Everything else -> SPA static files with history-API fallback
	# Only an APP ROUTE falls back to the SPA shell. A path with a file extension is a file: served
	# when it exists and a 404 when it does not. `try_files {path} /index.html` answered every missing
	# path with index.html and a 200, so a missing chunk (a page loaded before a deploy asking for a
	# hash that no longer exists), data file or licence came back as HTML. The browser then reported
	# a MIME or JSON parse error instead of a 404, which hides what is missing. Round 74. Both
	# Caddyfiles carry it.
	handle {
		root * /srv
		@route {
			not path_regexp \.[A-Za-z0-9]+$
			not file
		}
		rewrite @route /index.html
		file_server
	}
}

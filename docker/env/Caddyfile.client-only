# Caddy for the CLIENT-ONLY public demo: static SPA + cross-origin isolation, and NO /api.
#
# This file exists because the shared Caddyfile reverse-proxies /api to a backend container, and the
# public demo has no backend that can serve a run. The slim demo image is built without FHE/torch by
# design, so a request that reached it died at "No module named 'tenseal'". Proxying /api anyway left
# an endpoint on the public internet that any anonymous visitor could POST to in order to start
# server-side compute and write result files into the container, in exchange for a guaranteed error.
#
# /api and /metrics therefore return 404 here rather than being routed anywhere. The full deployment
# keeps docker/env/Caddyfile, which does proxy them.
{$SITE_ADDRESS::80} {
	encode gzip zstd

	# Cross-origin isolation -> SharedArrayBuffer / WebGPU / threaded WASM.
	# `>` sets rather than appends: the shared edge proxy in front of this one also emits COOP/COEP,
	# and two appended values produce "same-origin, same-origin", which is not a valid header value
	# and silently drops crossOriginIsolated back to false.
	header {
		>Cross-Origin-Opener-Policy "same-origin"
		>Cross-Origin-Embedder-Policy "require-corp"
		>Cross-Origin-Resource-Policy "cross-origin"
	}
	@wasm path *.wasm
	header @wasm Content-Type application/wasm

	# Caching (Round 86, 2026-11-15). Vite names every file under /assets/ by its content hash, so a name never
	# changes meaning and is kept for a year. Everything else, the app shell above all, is revalidated on each load
	# (ETag, a 304 when unchanged). With no header Chrome kept a shell by its heuristic, a tenth of the time since
	# Last-Modified, and after a deploy loaded a bundle the new image no longer serves. Both Caddyfiles carry it.
	# Only a file that exists: a 404 for a hash the image does not have must not be kept for a year, or a rollback
	# to the image that has it would stay broken in that browser.
	@hashed {
		path /assets/*
		file {
			root /srv
		}
	}
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@unhashed {
		not {
			path /assets/*
			file {
				root /srv
			}
		}
	}
	header @unhashed Cache-Control "no-cache"

	# No backend in this image. Answer honestly instead of proxying into a void.
	handle /api/* {
		respond "This is the client-side demo: all compute runs in the browser and there is no API." 404
	}
	handle /metrics {
		respond 404
	}

	# Only an APP ROUTE falls back to the SPA shell. A path with a file extension is a file: served
	# when it exists and a 404 when it does not. `try_files {path} /index.html` answered every missing
	# path with index.html and a 200, so a missing chunk (a page loaded before a deploy asking for a
	# hash that no longer exists), data file or licence came back as HTML. The browser then reported
	# a MIME or JSON parse error instead of a 404, which hides what is missing. Round 74. Both
	# Caddyfiles carry it.
	handle {
		root * /srv
		@route {
			not path_regexp \.[A-Za-z0-9]+$
			not file
		}
		rewrite @route /index.html
		file_server
	}
}

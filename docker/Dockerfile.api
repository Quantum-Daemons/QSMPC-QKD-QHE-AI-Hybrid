# Full local backend image (crypto + quantum + AI + FHE + API) — federated learning + inference.
# Base = Debian 13 (trixie): its libstdc++ (GLIBCXX_3.4.32+) matches the OpenFHE wheel and the
# Ubuntu-24.04 deploy target, so the OpenFHE CKKS backend is LIVE in the container.
# For GPU (Blackwell/CUDA13) run with the NVIDIA container runtime:
#   docker run --gpus all ...   (and install nvidia-container-toolkit on the host)
# Node.js 24 LTS for the filesystem-MCP interop, from the official image, pinned by digest (Round 86).
# Debian trixie's nodejs package is Node 20, past its upstream end of life on 2026-04-30, and the official
# @modelcontextprotocol/server-filesystem has declared `engines: node >= 24` since 2.0.0. Only the node
# binary and npm (with npx) are copied below; both images are Debian trixie, so they share one glibc.
FROM node:24.22.2-trixie-slim@sha256:54f84b4cf8432b21aaffd5d3ce8d41e12cea0d10d33c09d2f3c9879d49d6b446 AS node

FROM python:3.12-slim-trixie

ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 LD_LIBRARY_PATH=/usr/local/lib
WORKDIR /app

# libgomp1 = OpenMP runtime needed by the OpenFHE wheel and torch. libsodium23 = the libsodium that
# pysodium loads for the OPRF PSI's ristretto255 (qsh.qsmpc.oprf); without it the PSI runs on pure
# Python, which is not constant-time, and reports that it did.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake ninja-build git libssl-dev ca-certificates libgomp1 libsodium23 \
 && rm -rf /var/lib/apt/lists/*
# Node/npx are for the real filesystem-MCP interop (the official @modelcontextprotocol/server-filesystem
# is a Node package launched over stdio by qsh.mcp.fs_interop). Full deployment only; the slim demo image
# omits this (the demo never calls the server-side MCP — it uses the client-side mirror).
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
 && node --version && npm --version

# Build the liboqs C shared library at BUILD time (liboqs-python otherwise tries to
# build it on first import at RUNTIME, which needs network + libssl-dev). Baking it in
# makes the container import `oqs` offline.
#
# PINNED. This cloned the default branch, so the C library baked into the image was whatever `main`
# happened to be at build time: two builds of the same commit of THIS repo could ship different
# cryptography, with nothing recording which. 0.16.0 is the current release and matches the
# liboqs-python binding, which also closes the C 0.14.0 / binding 0.16.0 mismatch carried since
# Round 19. The build prints oqs.oqs_version() below; if that stops matching this tag, the mismatch
# is back.
ARG LIBOQS_TAG=0.16.0
RUN git clone --depth 1 --branch ${LIBOQS_TAG} https://github.com/open-quantum-safe/liboqs /tmp/liboqs \
 && cmake -S /tmp/liboqs -B /tmp/liboqs/build -GNinja \
      -DBUILD_SHARED_LIBS=ON -DCMAKE_INSTALL_PREFIX=/usr/local -DOQS_BUILD_ONLY_LIB=ON \
 && cmake --build /tmp/liboqs/build --parallel \
 && cmake --install /tmp/liboqs/build && ldconfig && rm -rf /tmp/liboqs

COPY requirements-core.txt requirements-ai.txt requirements-fhe.txt requirements-api.txt pyproject.toml ./
RUN pip install --upgrade pip wheel setuptools \
 && pip install -r requirements-core.txt -r requirements-api.txt -r requirements-fhe.txt

# AI tier (federated learning + private inference): CPU torch keeps the image portable and fits
# a 6-core/12 GB no-GPU VPS. On a GPU host, swap the index for a CUDA build.
RUN pip install torch torchvision --index-url https://download.pytorch.org/whl/cpu \
 && pip install -r requirements-ai.txt

# Bake the REAL MedMNIST dataset (PneumoniaMNIST, ~4 MB, CC-BY) into the image at BUILD time so the
# genuine medical CNN runs on real images at RUNTIME with no network. Per the no-easy-fallback policy
# the synthetic image generator is for offline CI only — never a silent runtime substitute for real data.
RUN python -c "from medmnist import PneumoniaMNIST; PneumoniaMNIST(split='train', download=True); print('MedMNIST PneumoniaMNIST baked into image')" \
 || echo "WARNING: MedMNIST prefetch failed at build (no network?) — runtime will attempt download"

COPY src ./src
COPY api ./api
RUN pip install -e .

# Bake the small committed real sample datasets (CC-BY/CC-BY-SA/CC0 — see DATA_LICENSES.md) so the
# genuine industry models run offline at RUNTIME with no network: the genomics PGS-Catalog Polygenic
# Risk Score weights are required by the genomics use case (the loader has no synthetic substitute —
# per the no-easy-fallback policy the real PRS path needs the real weights).
COPY data ./data

# Verify oqs finds the prebuilt shared library (fails the build early if not).
RUN python -c "import oqs; print('liboqs', oqs.oqs_version())"
# Non-fatal: report whether the live OpenFHE + torch backends are available in the image.
RUN python -c "import openfhe; print('OpenFHE CKKS backend: LIVE')" || echo "OpenFHE: unavailable (TenSEAL fallback)"
RUN python -c "import torch; print('torch', torch.__version__, 'CUDA', torch.cuda.is_available())"

# Node.js's own licence, which covers the components bundled into the binary, beside the binary the
# Node stage copied in (npm's travels inside its node_modules). Last, so a rebuild keeps the layers above.
COPY --from=node /usr/local/LICENSE /usr/local/share/doc/node/LICENSE

EXPOSE 8000
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]

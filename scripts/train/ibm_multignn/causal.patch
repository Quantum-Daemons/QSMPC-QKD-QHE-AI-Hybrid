+def _workers():
+    '''Loader processes for QSH_LOADER_WORKERS=n (this project's patch): sampling, not the model, bounds an epoch.'''
+    n = int(os.environ.get('QSH_LOADER_WORKERS', '0'))
+    return dict(num_workers=n, persistent_workers=True) if n > 0 else {}
+
+def seed_mask(batch, seed_ids):
+    '''The seed edges of a batch. IBM's rule is every copy of a seed's id. The causal sampler draws one subgraph per seed
+    (disjoint), where a seed can also be sampled as another seed's neighbour, so under QSH_CAUSAL=1 only the copy in the
+    seed's own subgraph is kept (this project's patch); otherwise a seed would count once for each copy.'''
+    et = ('node', 'to', 'node')
+    ids = batch[et].edge_attr[:, 0].detach().cpu()
+    mask = torch.isin(ids, seed_ids)
+    if not hasattr(batch['node'], 'batch'):
+        return mask
+    owner = batch['node'].batch.detach().cpu()[batch[et].edge_index[0].detach().cpu()]
+    order = torch.argsort(seed_ids)
+    sorted_ids = seed_ids[order]
+    at = torch.searchsorted(sorted_ids, ids).clamp(max=len(sorted_ids) - 1)
+    return mask & (order[at] == owner)
+
+class _TimeBatches(torch.utils.data.Sampler):
+    '''Mini-batches of the seeds that share one batch in time order (this project's causal patch, QSH_CAUSAL=1; a batch is
+    2,048 rows, split where it spans more than the fit window's reach, data_loading.causal_batches),
+    the batches in random order when training, in time order otherwise.'''
+    def __init__(self, seed_time, shuffle):
+        order = torch.argsort(seed_time, stable=True)
+        _, counts = torch.unique_consecutive(seed_time[order], return_counts=True)
+        self.groups = list(torch.split(order, counts.tolist()))
+        self.shuffle = shuffle
+
+    def __iter__(self):
+        idx = torch.randperm(len(self.groups)) if self.shuffle else torch.arange(len(self.groups))
+        for i in idx.tolist():
+            yield self.groups[i].tolist()
+
+    def __len__(self):
+        return len(self.groups)
+
+class _DropLater:
+    '''Drops every sampled edge later than the seeds' batch (this project's causal patch): the neighbours are
+    sampled as IBM's loader samples them, up to the fan-out from the whole graph, and only the earlier ones are kept.'''
+    EDGE_KEYS = ('edge_attr', 'y', 'timestamps', 'edge_time', 'e_id')
+
+    def __init__(self, seed_time, then=None):
+        self.seed_time, self.then = seed_time, then
+
+    def __call__(self, batch):
+        et = ('node', 'to', 'node')
+        cut = int(self.seed_time[batch[et].input_id].max())
+        for t in batch.edge_types:
+            store = batch[t]
+            keep = store.edge_time <= cut
+            n = store.edge_index.shape[1]
+            store.edge_index = store.edge_index[:, keep]
+            for key in self.EDGE_KEYS:
+                if key in store and getattr(store, key) is not None and getattr(store, key).shape[0] == n:
+                    setattr(store, key, getattr(store, key)[keep])
+        return self.then(batch) if self.then is not None else batch
+
+def _causal(data, idx, transform, shuffle):
+    '''Loader arguments for QSH_CAUSAL=1: one batch of 2,048 per mini-batch, later edges dropped; IBM's otherwise.'''
+    if os.environ.get('QSH_CAUSAL') != '1':
+        return None
+    t = data[('node', 'to', 'node')].edge_time
+    seed_time = t if idx is None else t[idx]
+    return dict(batch_sampler=_TimeBatches(seed_time, shuffle), transform=_DropLater(seed_time, transform))
+

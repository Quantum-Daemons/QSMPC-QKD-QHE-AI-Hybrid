+def causal_batches(ts, n_fit, rows=2048, plain=False):
+    '''Each edge's batch in time order, for the causal protocol (this project's patch, QSH_CAUSAL=1). A batch is 2,048
+    rows, split further wherever it spans more than the reach: the furthest any fit-window row sees to the end of its
+    batch of 2,048 (17 minutes on HI-Small), the horizon of the finance page's own models (finance_aml_fan.batch_reach).
+    No transaction then reads past the end of its batch of 2,048, nor more than the reach after it. On HI-Small the
+    split changes only the test window's sparse last days. With plain=True the batches are the 2,048-row ones.'''
+    ts = np.asarray(ts, dtype=np.float64)
+    n = len(ts)
+    end = np.minimum(n - 1, (np.arange(n) // rows + 1) * rows - 1)
+    reach = 60 * int((ts[end] - ts)[:n_fit].max() // 60)
+    if plain:
+        return np.arange(n, dtype=np.int64) // rows, reach
+    ids, b, t0 = np.empty(n, dtype=np.int64), -1, 0.0
+    for i, t in enumerate(ts.tolist()):
+        if i % rows == 0 or t - t0 > reach:
+            b, t0 = b + 1, t
+        ids[i] = b
+    return ids, reach
+
